{
  "name": "aero-enrichment",
  "version": "2.0.0",
  "description": "A comprehensive company enrichment platform with ICP Signal Discovery, combining Exa Websets, SEC Edgar, AI analysis, and web scraping.",
  "main": "lib/aero-enrichment.js",
  "types": "lib/aero-enrichment.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/test.ts",
    "test": "jest",
    "test:integration": "tsx src/test.ts",
    "example": "tsx src/example.ts",
    "start": "node lib/aero-enrichment.js",
    "lint": "echo 'Linting not configured yet'",
    "type-check": "tsc --noEmit",
    "tam-expansion": "tsx src/tam-expansion.ts",
    "tam-expansion:sample": "tsx src/tam-expansion.ts --sample-size 100",
    "tam-expansion:full": "tsx src/tam-expansion.ts --sample-size 10000",
    "icp-discovery": "tsx scripts/run-icp-discovery.ts",
    "icp-discovery:help": "tsx scripts/run-icp-discovery.ts --help"
  },
  "keywords": [
    "aerospace",
    "defense",
    "company-enrichment",
    "data-intelligence",
    "sec-filings",
    "ticker-discovery",
    "ai-analysis",
    "web-scraping",
    "crustdata",
    "exa",
    "firecrawl"
  ],
  "author": "Fire Enrich Team",
  "license": "MIT",
  "dependencies": {
    "@mendable/firecrawl-js": "^1.0.0",
    "@types/turndown": "^5.0.6",
    "dotenv": "^17.2.1",
    "exa-js": "^1.10.2",
    "openai": "^4.0.0",
    "turndown": "^7.2.2",
    "uuid": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/uuid": "^9.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jptoor/aero-enrichment.git"
  },
  "bugs": {
    "url": "https://github.com/jptoor/aero-enrichment/issues"
  },
  "homepage": "https://github.com/jptoor/aero-enrichment#readme"
}

# Optional Firecrawl API key for Firecrawl research, HTML scraping and chat
# With no key configured, enrichment uses free anonymous Parallel Search MCP.
# Get yours at https://firecrawl.dev
# FIRECRAWL_API_KEY=fc-your-api-key-here

# Optional server override: parallel, firecrawl (requires a key), or disabled
# WEB_SEARCH_PROVIDER=parallel

# OpenAI API Key  
# Get yours at https://platform.openai.com
OPENAI_API_KEY=sk-your-api-key-here

# Enable unlimited mode (optional)
# When true, removes all limits on rows, columns, and file size
# Automatically enabled in development mode
FIRE_ENRICH_UNLIMITED=true

# Node environment (development/production)
NODE_ENV=development